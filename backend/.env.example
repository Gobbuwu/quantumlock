# Local settings for the backend. Copy this file to ".env" (same folder) and fill it in.
# ".env" is ignored by git. Never commit it and never put real values in this example file.

# Password of the PostgreSQL user "quantumlock" that you chose when creating the database (required).
# Write it exactly as it is, without quotes. Avoid a backslash in the password: this file format
# treats it as an escape character.
DB_PASSWORD=

# Encrypts every private key the backend stores (required). 32 random bytes, Base64 encoded.
# Create your own, never reuse one from somewhere else:
#   Windows PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   macOS or Linux:     openssl rand -base64 32
# Keep a copy somewhere safe: without it the stored private keys cannot be used.
MASTER_KEY=

# Optional overrides. The defaults are shown.
# DB_URL=jdbc:postgresql://localhost:5432/quantumlock
# DB_USERNAME=quantumlock
# PORT=8080
# API_DOCS_ENABLED=true
# MAX_REQUEST_BYTES=65536
# Key rotation: days the old key pair still decapsulates and verifies, when the caller does not say,
# and the most a caller may ask for (0 to 3650).
# ROTATION_GRACE_DAYS=7
# ROTATION_MAX_GRACE_DAYS=90
# Rate limits, each per minute (1 to 1000000): requests per API key, and failed API-key checks per client address.
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_FAILED_CHECKS_PER_MINUTE=20

# Leave these two alone unless you know why you are changing them (see SECURITY.md).
# SERVER_ADDRESS=127.0.0.1
# ALLOWED_HOSTS=localhost,127.0.0.1
